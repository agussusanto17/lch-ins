# Database PostgreSQL untuk Prisma.
# Salin file ini jadi .env lalu sesuaikan.
# Di Vercel tidak perlu DATABASE_URL bila integrasi Prisma Postgres sudah
# tersambung: lch_POSTGRES_URL dari integrasi ikut dibaca (lib/database-url.ts).
DATABASE_URL="postgresql://lch:lch@localhost:5432/lch_dev?schema=public"

# Kunci untuk menandatangani cookie sesi Better Auth.
# Buat nilai acak sendiri, misalnya:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=""
# Alamat dasar aplikasi. Di Vercel isi dengan domain produksinya.
BETTER_AUTH_URL="http://localhost:3000"
