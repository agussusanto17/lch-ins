# Database PostgreSQL untuk Prisma.
# Salin file ini jadi .env lalu sesuaikan.
# Di Vercel tidak perlu DATABASE_URL bila integrasi Prisma Postgres sudah
# tersambung: lch_POSTGRES_URL dari integrasi ikut dibaca (lib/database-url.ts).
DATABASE_URL="postgresql://lch:lch@localhost:5432/lch_dev?schema=public"

# Kunci untuk menandatangani cookie sesi Better Auth.
# Buat nilai acak sendiri, misalnya:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=""
# Alamat dasar aplikasi. Di Vercel isi dengan domain produksinya.
BETTER_AUTH_URL="http://localhost:3000"

# Object storage S3 (RustFS) untuk isi berkas unggahan. Kalau dikosongkan,
# isi berkas disimpan di tabel stored_files seperti sebelumnya (demo Vercel).
# Untuk RustFS lokal: docker run -p 9000:9000 rustfs/rustfs, lalu buat bucket.
S3_ENDPOINT=""
S3_REGION="us-east-1"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_BUCKET=""

# Pasang true di VPS lch-server agar aplikasi menolak menyimpan berkas ke database
# bila S3 belum terpasang atau gagal dihubungi (wajib object storage murni).
REQUIRE_OBJECT_STORAGE="false"
