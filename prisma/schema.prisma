// ---------------------------------------------------------------------------
// 3. Marketing dan underwriting
// ---------------------------------------------------------------------------

/// Data klien mengikuti form KYC LCH. Klien perorangan mengisi tempat dan
/// tanggal lahir serta nomor identitas, klien korporasi mengisi NPWP, nama PIC,
/// dan nomor KTP PIC. Keduanya mengisi tujuan menutup asuransi.
model Client {
  id                    String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// lookup client_type: Perorangan atau Korporasi.
  clientTypeId          String    @map("client_type_id") @db.Uuid
  /// Nama lengkap atau nama perusahaan.
  name                  String
  npwp                  String?
  /// lookup id_type: KTP, SIM, atau Paspor.
  idTypeId              String?   @map("id_type_id") @db.Uuid
  idNumber              String?   @map("id_number")
  /// Klien perorangan.
  birthPlace            String?   @map("birth_place")
  birthDate             DateTime? @map("birth_date") @db.Date
  /// PIC perusahaan.
  contactPerson         String?   @map("contact_person")
  contactPersonIdNumber String?   @map("contact_person_id_number")
  email                 String?
  phone                 String?
  /// lookup income_source
  incomeSourceId        String?   @map("income_source_id") @db.Uuid
  /// lookup insurance_purpose
  insurancePurposeId    String?   @map("insurance_purpose_id") @db.Uuid
  /// Diisi bila tujuannya Lain-lain.
  insurancePurposeNote  String?   @map("insurance_purpose_note")
  kycDate               DateTime? @map("kyc_date") @db.Date
  /// COB utama klien.
  cobId                 String?   @map("cob_id") @db.Uuid
  /// lookup client_status: Prospect, Active, Inactive.
  statusId              String    @map("status_id") @db.Uuid
  notes                 String?

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  clientType       LookupValue      @relation("client_type", fields: [clientTypeId], references: [id])
  idType           LookupValue?     @relation("id_type", fields: [idTypeId], references: [id])
  incomeSource     LookupValue?     @relation("income_source", fields: [incomeSourceId], references: [id])
  insurancePurpose LookupValue?     @relation("insurance_purpose", fields: [insurancePurposeId], references: [id])
  status           LookupValue      @relation("client_status", fields: [statusId], references: [id])
  cob              ClassOfBusiness? @relation(fields: [cobId], references: [id])

  addresses    ClientAddress[]
  documents    ClientDocument[]
  insurerCodes ClientInsurerCode[]
  sppa         Sppa[]
  placingSlips PlacingSlip[]
  policies     Policy[]
  debitNotes   DebitNote[]
  journalLines JournalLine[]

  @@index([name])
  @@index([statusId])
  @@map("clients")
}

/// Satu klien bisa punya beberapa alamat, karena form KYC korporasi memisahkan
/// alamat perusahaan dan alamat korespondensi.
model ClientAddress {
  id            String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clientId      String  @map("client_id") @db.Uuid
  /// lookup address_type: Alamat perusahaan, Korespondensi, Penagihan.
  addressTypeId String  @map("address_type_id") @db.Uuid
  address       String
  phone         String?
  isPrimary     Boolean @default(false) @map("is_primary")
  isActive      Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  client      Client      @relation(fields: [clientId], references: [id], onDelete: Cascade)
  addressType LookupValue @relation("address_type", fields: [addressTypeId], references: [id])

  placingSlips PlacingSlip[]

  @@index([clientId])
  @@map("client_addresses")
}

/// Berkas KYC: copy KTP, copy NPWP, form KYC, dan lainnya.
model ClientDocument {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clientId       String   @map("client_id") @db.Uuid
  /// lookup client_document_type
  documentTypeId String   @map("document_type_id") @db.Uuid
  fileName       String   @map("file_name")
  /// `stored_files/<id>` bila isinya tersimpan di tabel stored_files. Nilai
  /// lain berasal dari data contoh atau prototipe dan tidak punya isi.
  filePath       String   @map("file_path")
  uploadedBy     String   @map("uploaded_by") @db.Uuid
  uploadedAt     DateTime @default(now()) @map("uploaded_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  client       Client      @relation(fields: [clientId], references: [id], onDelete: Cascade)
  documentType LookupValue @relation("client_document_type", fields: [documentTypeId], references: [id])
  uploader     User        @relation(fields: [uploadedBy], references: [id])

  @@index([clientId])
  @@map("client_documents")
}

/// Metadata berkas yang diunggah pengguna. Baris pemakainya menunjuk ke sini
/// lewat file_path `stored_files/<id>`.
///
/// Isi berkas disimpan di object storage (RustFS) bila env S3_* terisi, dan
/// barisnya hanya membawa storage_key. Tanpa object storage (demo Vercel), isi
/// berkas tetap disimpan di kolom data. Tepat satu dari keduanya terisi.
model StoredFile {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  fileName    String   @map("file_name")
  /// Dibaca dari isi file saat diunggah, bukan dari keterangan browser.
  contentType String   @map("content_type")
  sizeBytes   Int      @map("size_bytes")
  /// Isi berkas, hanya bila tidak memakai object storage.
  data        Bytes?
  /// Key objek di bucket S3_BUCKET, misalnya `client_document/<id>`.
  storageKey  String?  @unique @map("storage_key")
  /// Pemakaian berkas, menentukan hak akses saat dibuka: client_document, claim_document, policy_file.
  purpose     String
  uploadedBy  String   @map("uploaded_by") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  uploader User @relation(fields: [uploadedBy], references: [id])

  @@map("stored_files")
}

/// Kode nasabah di sistem masing-masing asuransi (ERD client_insurer_codes).
/// Contoh D45BL00001 di Asuransi Sinar Mas.
model ClientInsurerCode {
  id        String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clientId  String @map("client_id") @db.Uuid
  insurerId String @map("insurer_id") @db.Uuid
  code      String

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  client  Client  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  insurer Insurer @relation(fields: [insurerId], references: [id], onDelete: Cascade)

  @@unique([clientId, insurerId])
  @@index([clientId])
  @@index([insurerId])
  @@map("client_insurer_codes")
}

/// Surat Permintaan Penutupan Asuransi yang diisi Marketing.
model Sppa {
  id           String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clientId     String     @map("client_id") @db.Uuid
  cobId        String     @map("cob_id") @db.Uuid
  coverTypeId  String?    @map("cover_type_id") @db.Uuid
  insuredName  String     @map("insured_name")
  riskLocation String?    @map("risk_location")
  occupationId String?    @map("occupation_id") @db.Uuid
  currencyCode String     @map("currency_code")
  sumInsured   Decimal?   @map("sum_insured") @db.Decimal(18, 2)
  periodStart  DateTime?  @map("period_start") @db.Date
  periodEnd    DateTime?  @map("period_end") @db.Date
  /// Isian khusus per COB. Bentuknya jsonb sampai contoh form SPPA dari LCH
  /// diterima, lalu dipecah jadi kolom kalau sudah jelas.
  answers      Json?      @db.JsonB
  status       SppaStatus @default(Draft)
  createdBy    String     @map("created_by") @db.Uuid
  /// Hanya untuk COB Motor Vehicle.
  vehicleBrandId String? @map("vehicle_brand_id") @db.Uuid
  vehicleTypeId  String? @map("vehicle_type_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  client       Client          @relation(fields: [clientId], references: [id])
  cob          ClassOfBusiness @relation(fields: [cobId], references: [id])
  coverType    CoverType?      @relation(fields: [coverTypeId], references: [id])
  occupation   Occupation?     @relation(fields: [occupationId], references: [id])
  currency     Currency        @relation(fields: [currencyCode], references: [code])
  creator      User            @relation(fields: [createdBy], references: [id])
  vehicleBrand VehicleBrand?   @relation(fields: [vehicleBrandId], references: [id], onDelete: Restrict)
  vehicleType  VehicleType?    @relation(fields: [vehicleTypeId], references: [id], onDelete: Restrict)

  placingSlips PlacingSlip[]

  @@index([clientId])
  @@map("sppa")
}

/// Placing slip, sekaligus menyimpan nomor dan isi Quotation Slip, Cover Note,
/// dan Closing Instruction yang terbit darinya.
///
/// Total premium, diskon, total payable, brokerage, dan net premium TIDAK
/// disimpan di sini. Semuanya dihitung dari slip_rate_lines.
model PlacingSlip {
  id     String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Terisi saat release.
  slipNo String? @unique @map("slip_no")

  clientId    String  @map("client_id") @db.Uuid
  sppaId      String? @map("sppa_id") @db.Uuid
  cobId       String  @map("cob_id") @db.Uuid
  coverTypeId String? @map("cover_type_id") @db.Uuid
  /// Sumber penempatan / bisnis (ERD sources).
  sourceId    String? @map("source_id") @db.Uuid
  /// Label pilihan form, misal "PAR + EQVET". Tidak semua label punya padanan di cover_types.
  typeOfCover String? @map("type_of_cover")
  /// Type of cover kedua slip Property (Earthquake), dicetak di bawah yang
  /// pertama dan dipakai polis EQVET (Harry, 5 Nov 2026).
  coverType2Id String? @map("cover_type_2_id") @db.Uuid
  typeOfCover2 String? @map("type_of_cover_2")
  /// Nama type of cover yang dicetak di dokumen bila berbeda dari master,
  /// misalnya "PROPERTY ALL RISKS + RIOTS, STRIKES, ... INSURANCE." seperti CI
  /// LCH. Kosong berarti nama master.
  typeOfCoverLabel  String? @map("type_of_cover_label")
  typeOfCover2Label String? @map("type_of_cover_2_label")

  /// Salinan dari klien. Bisa diedit di slip tanpa mengubah data klien.
  insuredName             String  @map("insured_name")
  /// Uraian tertanggung yang dicetak di bawah Insured Name dengan huruf asli,
  /// misalnya daftar pihak a), b), c) atau "and/or subsidiary companies".
  insuredDescription      String? @map("insured_description")
  /// Salinan alamat klien yang dipilih, juga bisa diedit.
  correspondenceAddress   String? @map("correspondence_address")
  /// Alamat klien asal salinan di atas, untuk jejak. Kosong bila diketik manual.
  correspondenceAddressId String? @map("correspondence_address_id") @db.Uuid

  currencyCode String     @map("currency_code")
  status       SlipStatus @default(Draft)

  periodTba     Boolean   @default(false) @map("period_tba")
  inceptionDate DateTime? @map("inception_date") @db.Date
  expiryDate    DateTime? @map("expiry_date") @db.Date
  /// Keterangan di bawah periode asuransi, misalnya "Both days at 12 o'clock
  /// noon local time at the location of the insured object." seperti CI LCH.
  periodNote    String?   @map("period_note")
  /// Label periode di dokumen, misalnya "Estimated of Departure (ETD)" atau
  /// "Date of Tournament". Kosong berarti "Period of Insurance".
  periodLabel   String?   @map("period_label")
  /// Teks periode di dokumen yang menggantikan tanggal dan keterangannya,
  /// misalnya ETD single shipment atau periode proyek T.B.A. Tanggal tetap
  /// disimpan untuk polis.
  periodText    String?   @map("period_text")
  /// Teks pengganti tanggal akhir di dokumen, misalnya "until final
  /// destination": dicetak "23 October 2026 until final destination". Tanggal
  /// akhir tetap disimpan untuk polis. Nilai awal dari type of cover.
  periodEndText String?   @map("period_end_text")
  /// Detail tambahan: baris {label, value} yang dicetak di tabel detail
  /// dokumen setelah baris bawaan, misalnya Retroactive Date, Voyage, Vessels.
  detailRows    Json      @default("[]") @map("detail_rows") @db.JsonB
  /// Limit manfaat PA dalam persen UP per kode lookup pa_benefit, misalnya
  /// {"death":100,"disability":100,"medical":10}. Dipakai peringatan klaim.
  paBenefitLimits Json?   @map("pa_benefit_limits") @db.JsonB
  /// Slip COB selain Property dan Motor Vehicle yang dibagi Section 1
  /// (Material Damage) dan Section 2 (Third Party Liability), seperti CAR/EAR.
  usesSections  Boolean   @default(false) @map("uses_sections")
  /// Open cover: rate per kategori tanpa TSI dan premi; premi dicatat per
  /// deklarasi sebagai polis (MOP dan container open cover LCH).
  openCover      Boolean  @default(false) @map("open_cover")
  /// Rate open cover: [{id, label, basis: percent|per_unit, rate, unit}].
  openCoverRates Json     @default("[]") @map("open_cover_rates") @db.JsonB

  occupationId        String? @map("occupation_id") @db.Uuid
  /// Nama okupasi yang dicetak di dokumen slip, tanpa kode. Kosong berarti
  /// nama sesuai OJK. Seperti override klausul, master okupasi tidak berubah.
  occupationLabel     String? @map("occupation_label")
  riskLocation        String? @map("risk_location")
  coverage            String?
  /// lookup construction_class: K1, K2, K3.
  constructionClassId String? @map("construction_class_id") @db.Uuid
  /// FK ke skala BI.
  indemnityMonths     Int?    @map("indemnity_months")

  interestSection1  String? @map("interest_section1")
  interestSection2  String? @map("interest_section2")
  specialConditions String? @map("special_conditions")
  /// Kalimat di atas daftar deductible, diketik user, misalnya "Any one loss
  /// or series of losses arising out of any one event:". Kosong = tidak dicetak.
  deductibleIntro   String? @map("deductible_intro")
  /// Exclusion slip, satu per baris dengan nomor yang diketik sendiri, dicetak
  /// sebagai blok EXCLUSIONS setelah CLAUSES (CI CGL Orela, PL Infiniti).
  exclusions        String?

  discountPct  Decimal @default(0) @map("discount_pct") @db.Decimal(12, 6)
  adminCost    Decimal @default(0) @map("admin_cost") @db.Decimal(18, 2)
  stampDuty    Decimal @default(0) @map("stamp_duty") @db.Decimal(18, 2)
  /// Dibatasi biaya akuisisi OJK: maksimal 15% harta benda, 25% kendaraan
  /// bermotor. Sistem memperingatkan bila dilewati.
  brokeragePct Decimal @default(0) @map("brokerage_pct") @db.Decimal(12, 6)
  includeVat   Boolean @default(false) @map("include_vat")

  /// Tidak dipakai lagi sejak 12 Nov 2026: additional fee menjadi persen per
  /// asuransi di panel Security (`slip_security_panel.additional_fee_pct`),
  /// nominalnya dihitung dari premi. Kolom dibiarkan sebagai isian lama.
  additionalFee Decimal @default(0) @map("additional_fee") @db.Decimal(18, 2)
  /// Additional fee sudah termasuk PPN 2,2%, seperti Include VAT di brokerage.
  additionalFeeIncludeVat Boolean @default(false) @map("additional_fee_include_vat")

  /// Tidak dipakai lagi sejak 5 Nov 2026: loss limit menjadi persentase per
  /// baris rate (`slip_rate_lines.loss_limit_pct`). Kolom dibiarkan supaya
  /// kode versi sebelumnya tetap jalan selama deploy.
  lossLimit           Decimal? @map("loss_limit") @db.Decimal(18, 2)
  lossLimitPremiumPct Decimal? @map("loss_limit_premium_pct") @db.Decimal(5, 2)

  subjectivity       String?
  quotationNo        String? @unique @map("quotation_no")
  coverNoteNo        String? @unique @map("cover_note_no")
  coverNoteRemarks   String? @map("cover_note_remarks")
  closingNo          String? @unique @map("closing_no")
  closingInstruction String? @map("closing_instruction")

  releasedAt DateTime? @map("released_at") @db.Timestamptz(6)
  releasedBy String?   @map("released_by") @db.Uuid
  createdBy  String    @map("created_by") @db.Uuid

  /// Tanggal dokumen (disetujui Harry, 10 November 2026): Placing Slip memakai
  /// tanggal release, Quotation Slip dan Draft Cover Note tanggal quoted,
  /// Closing Instruction tanggal closing. Terisi otomatis saat status
  /// berpindah dan bisa diubah manual untuk dokumen lama. Dokumen bertanggal
  /// sebelum 1 September 2025 memakai kop Lestari Cipta Hokindo.
  releaseDate DateTime? @map("release_date") @db.Date
  quotedDate  DateTime? @map("quoted_date") @db.Date
  closingDate DateTime? @map("closing_date") @db.Date

  /// Placing slip, endorsement slip, atau cancellation slip (Harry, 11 November
  /// 2026). Endorsement dan cancellation dibuat dari slip polis yang sudah
  /// Closed; nomornya ES/CS dari urutan nomor placing slip.
  kind              SlipKind  @default(Placing)
  /// Polis yang di-endorse atau dibatalkan.
  parentPolicyId    String?   @map("parent_policy_id") @db.Uuid
  /// Slip asal: kondisi sebelum perubahan.
  baseSlipId        String?   @map("base_slip_id") @db.Uuid
  /// Tanggal efektif endorsement atau pembatalan.
  effectiveDate     DateTime? @map("effective_date") @db.Date
  /// Uraian perubahan yang dicetak di endorsement slip.
  changeDescription String?   @map("change_description")
  /// Baris premi slip asal saat endorsement dibuat: dasar perhitungan "sebelum".
  beforeCalc        Json?     @map("before_calc") @db.JsonB

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  client                      Client          @relation(fields: [clientId], references: [id])
  sppa                        Sppa?           @relation(fields: [sppaId], references: [id])
  cob                         ClassOfBusiness @relation(fields: [cobId], references: [id])
  coverType                   CoverType?      @relation("SlipCoverType", fields: [coverTypeId], references: [id])
  coverType2                  CoverType?      @relation("SlipCoverType2", fields: [coverType2Id], references: [id])
  source                      Source?         @relation(fields: [sourceId], references: [id])
  correspondenceAddressSource ClientAddress?  @relation(fields: [correspondenceAddressId], references: [id])
  currency                    Currency        @relation(fields: [currencyCode], references: [code])
  occupation                  Occupation?     @relation(fields: [occupationId], references: [id])
  constructionClass           LookupValue?    @relation("construction_class", fields: [constructionClassId], references: [id])
  biScale                     BiScale?        @relation(fields: [indemnityMonths], references: [indemnityMonths])
  releaser                    User?           @relation("slipReleasedBy", fields: [releasedBy], references: [id])
  creator                     User            @relation("slipCreatedBy", fields: [createdBy], references: [id])
  parentPolicy                Policy?         @relation("slipParentPolicy", fields: [parentPolicyId], references: [id], onDelete: SetNull)
  baseSlip                    PlacingSlip?    @relation("slipBase", fields: [baseSlipId], references: [id], onDelete: SetNull)

  locations     SlipLocation[]
  items         SlipItem[]
  rateLines     SlipRateLine[]
  securityPanel SlipSecurityPanel[]
  clauses       SlipClause[]
  participants SlipParticipant[]
  files         SlipFile[]
  wordingForms  SlipWordingForm[]
  policies      Policy[]
  /// Endorsement dan cancellation slip yang dibuat dari slip ini.
  derivedSlips  PlacingSlip[] @relation("slipBase")

  @@index([clientId])
  @@index([status])
  @@index([parentPolicyId])
  @@map("placing_slips")
}

/// Lokasi risiko slip Property (Harry, 5 November 2026). Tiap lokasi punya
/// okupasi, kelas konstruksi, sum insured, dan rate sendiri. Okupasi, risk
/// location, dan kelas di placing_slips diisi dari lokasi pertama supaya modul
/// lain tetap membaca satu nilai.
model SlipLocation {
  id                  String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slipId              String  @map("slip_id") @db.Uuid
  sortOrder           Int     @default(0) @map("sort_order")
  riskLocation        String? @map("risk_location")
  occupationId        String? @map("occupation_id") @db.Uuid
  /// Nama okupasi yang dicetak untuk lokasi ini; kosong berarti nama OJK.
  occupationLabel     String? @map("occupation_label")
  /// lookup construction_class: K1, K2, K3.
  constructionClassId String? @map("construction_class_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  slip              PlacingSlip    @relation(fields: [slipId], references: [id], onDelete: Cascade)
  occupation        Occupation?    @relation(fields: [occupationId], references: [id])
  constructionClass LookupValue?   @relation("location_construction_class", fields: [constructionClassId], references: [id])
  items             SlipItem[]
  rateLines         SlipRateLine[]

  @@index([slipId, sortOrder])
  @@map("slip_locations")
}

/// Interest insured, sum insured, dan deductible. Dibedakan lewat kind.
model SlipItem {
  id          String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slipId      String       @map("slip_id") @db.Uuid
  kind        SlipItemKind
  description String
  /// Kosong untuk baris deductible.
  amount      Decimal?     @db.Decimal(18, 2)
  /// Nilai yang hanya batas (limit): tidak ikut total sum insured dan premi,
  /// misalnya limit any one carrying CIT. Hanya baris Interest COB selain
  /// Property dan Motor Vehicle.
  isLimitOnly Boolean      @default(false) @map("is_limit_only")
  /// Section objek Interest di slip ber-section: 2 = Third Party Liability.
  /// Kosong berarti Section 1.
  sectionNo   Int?         @map("section_no") @db.SmallInt
  sortOrder   Int          @default(0) @map("sort_order")
  /// Hanya baris Interest slip Motor Vehicle.
  vehicleBrandId String? @map("vehicle_brand_id") @db.Uuid
  vehicleTypeId  String? @map("vehicle_type_id") @db.Uuid
  /// Lokasi slip Property untuk baris sum insured Section 1 dan 2.
  locationId     String? @map("location_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  slip         PlacingSlip   @relation(fields: [slipId], references: [id], onDelete: Cascade)
  location     SlipLocation? @relation(fields: [locationId], references: [id], onDelete: Cascade)
  vehicleBrand VehicleBrand? @relation(fields: [vehicleBrandId], references: [id], onDelete: Restrict)
  vehicleType  VehicleType?  @relation(fields: [vehicleTypeId], references: [id], onDelete: Restrict)
  /// Baris rate, TPL, dan PA milik kendaraan atau objek ini.
  vehicleRateLines SlipRateLine[] @relation("rate_line_vehicle")

  @@index([slipId, kind, sortOrder])
  @@map("slip_items")
}

/// Baris rate slip. Menyimpan salinan batas OJK yang berlaku saat input, lalu
/// rate divalidasi terhadap batas itu.
///
/// Rate boleh di bawah batas bawah bila ada potongan sesuai nilai
/// pertanggungan, dan di atas batas atas bila ada perluasan jaminan. Jadi
/// validasinya menolak dengan pengecualian yang dicatat alasannya.
model SlipRateLine {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slipId            String   @map("slip_id") @db.Uuid
  /// lookup rate_line_kind: Rate, TPL, atau PA.
  kindId            String   @map("kind_id") @db.Uuid
  label             String
  /// Basis perhitungan untuk TPL dan PA. Baris Rate memakai total sum insured.
  limitAmount       Decimal? @map("limit_amount") @db.Decimal(18, 2)
  rate              Decimal? @db.Decimal(12, 6)
  premium           Decimal  @default(0) @db.Decimal(18, 2)
  /// Premi flat: premi diisi langsung tanpa rate, misalnya Liability dan MB
  /// (contoh slip LCH). Hanya COB selain Property dan Motor Vehicle.
  isFlatPremium     Boolean  @default(false) @map("is_flat_premium")
  /// Batas bawah dan atas OJK saat rate diisi.
  rateMin           Decimal? @map("rate_min") @db.Decimal(12, 6)
  rateMax           Decimal? @map("rate_max") @db.Decimal(12, 6)
  /// Persentase loss limit baris Property: premi = sum insured × rate ×
  /// persentase. Kosong berarti full value.
  lossLimitPct      Decimal? @map("loss_limit_pct") @db.Decimal(7, 4)
  /// Lokasi slip Property untuk baris rate. TPL, PA, dan COB lain kosong.
  locationId        String?  @map("location_id") @db.Uuid
  /// Baris Interest pemilik baris rate, TPL, atau PA: kendaraan di Motor
  /// Vehicle, objek di COB lain selain Property (5 November 2026). Namanya
  /// tetap "vehicle" karena mula-mula dipakai untuk kendaraan.
  vehicleItemId     String?  @map("vehicle_item_id") @db.Uuid
  /// Alasan bila rate keluar dari batas OJK.
  outOfBoundsReason String?  @map("out_of_bounds_reason")
  /// Tidak dipakai lagi sejak satu cover bisa punya beberapa deductible
  /// (4 Nov 2026); isinya disalin ke `deductibles`.
  deductible        String?
  /// Deductible untuk cover baris ini, teks bebas, paling banyak lima.
  /// Instruksi LCH 29 Oktober 2026: deductible dibuat per cover, bukan per
  /// section.
  deductibles       String[] @default([])
  sortOrder         Int      @default(0) @map("sort_order")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  slip        PlacingSlip   @relation(fields: [slipId], references: [id], onDelete: Cascade)
  location    SlipLocation? @relation(fields: [locationId], references: [id], onDelete: Cascade)
  vehicleItem SlipItem?     @relation("rate_line_vehicle", fields: [vehicleItemId], references: [id], onDelete: Cascade)
  kind        LookupValue   @relation("rate_line_kind_slip", fields: [kindId], references: [id])

  @@index([slipId, sortOrder])
  @@map("slip_rate_lines")
}

/// Asuransi yang ditawari beserta sharenya. Total share harus 100%.
model SlipSecurityPanel {
  id         String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slipId     String  @map("slip_id") @db.Uuid
  insurerId  String  @map("insurer_id") @db.Uuid
  sharePct   Decimal @map("share_pct") @db.Decimal(12, 6)
  /// lookup security_role: As Leader atau As Member.
  positionId String  @map("position_id") @db.Uuid
  /// Additional fee (%) dari premi bagian asuransi ini, diisi saat closing
  /// (Harry, 12 November 2026). Hanya slip Property dan Motor Vehicle.
  additionalFeePct Decimal @default(0) @map("additional_fee_pct") @db.Decimal(12, 6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  slip     PlacingSlip @relation(fields: [slipId], references: [id], onDelete: Cascade)
  insurer  Insurer     @relation(fields: [insurerId], references: [id])
  position LookupValue @relation("security_role_slip", fields: [positionId], references: [id])

  @@unique([slipId, insurerId])
  @@map("slip_security_panel")
}

/// Klausula yang dipakai slip. Wording disalin dari master saat dipilih dan
/// bisa diedit per slip. Master clause tidak berubah, dan slip lama tidak ikut
/// berubah kalau master diperbarui.
model SlipClause {
  id          String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slipId      String  @map("slip_id") @db.Uuid
  clauseId    String  @map("clause_id") @db.Uuid
  title       String
  /// Salinan, bisa diedit per slip.
  wordingHtml String  @map("wording_html")
  /// Menandai wording yang sudah diubah dari master, supaya kelihatan saat
  /// review slip.
  isEdited    Boolean @default(false) @map("is_edited")
  /// Slip Property: 1 Material Damage, 2 Business Interruption. Klausula yang
  /// berlaku untuk keduanya punya satu baris per section. COB lain selalu 1.
  section     Int     @default(1) @db.SmallInt
  /// Judul kelompok klausul di slip tanpa section, misalnya "Extensions" atau
  /// "General Conditions". Kosong berarti kelompok tanpa judul.
  groupTitle  String? @map("group_title")
  sortOrder   Int     @default(0) @map("sort_order")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  slip   PlacingSlip @relation(fields: [slipId], references: [id], onDelete: Cascade)
  clause Clause      @relation(fields: [clauseId], references: [id])

  @@unique([slipId, section, clauseId])
  @@index([slipId, sortOrder])
  @@map("slip_clauses")
}

/// Peserta PA grup per orang (jawaban Harry, 6 November 2026): dicetak
/// sebagai lampiran slip, dan nantinya dipakai klaim serta endorsement
/// tambah/kurang peserta.
model SlipParticipant {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slipId       String    @map("slip_id") @db.Uuid
  name         String
  /// NIK atau nomor paspor.
  idNumber     String?   @map("id_number")
  birthDate    DateTime? @map("birth_date") @db.Date
  gender       String?
  position     String?
  /// Level jabatan atau plan.
  level        String?
  workLocation String?   @map("work_location")
  sumInsured   Decimal   @default(0) @map("sum_insured") @db.Decimal(18, 2)
  beneficiary  String?
  sortOrder    Int       @default(0) @map("sort_order")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  slip PlacingSlip @relation(fields: [slipId], references: [id], onDelete: Cascade)

  @@index([slipId, sortOrder])
  @@map("slip_participants")
}

model SlipWordingForm {
  slipId        String @map("slip_id") @db.Uuid
  wordingFormId String @map("wording_form_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  slip        PlacingSlip @relation(fields: [slipId], references: [id], onDelete: Cascade)
  wordingForm WordingForm @relation(fields: [wordingFormId], references: [id])

  @@id([slipId, wordingFormId])
  @@map("slip_wording_forms")
}

// ---------------------------------------------------------------------------
// 4. Polis dan klaim
// ---------------------------------------------------------------------------

/// Status polis (aktif, akan berakhir, berakhir) dihitung dari expiry_date,
/// tidak disimpan dan tidak ada di form.
///
/// Endorsement dan pembatalan dicatat sebagai baris polis tersendiri dengan
/// policy_type Endorsement atau Cancellation dan parent_policy_id menunjuk
/// polis induknya. Tambahan premi bernilai positif, pengembalian premi negatif.
model Policy {
  id                  String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  policyNo            String   @unique @map("policy_no")
  placingSlipId       String?  @map("placing_slip_id") @db.Uuid
  /// Bagian slip PAR + EQVET yang menjadi polis ini: PAR atau EQVET. Kosong
  /// untuk slip yang terbit sebagai satu polis. Satu slip satu polis, slip
  /// PAR + EQVET satu polis per bagian (dicek di server).
  slipPart            String?  @map("slip_part")
  clientId            String?  @map("client_id") @db.Uuid
  cobId               String   @map("cob_id") @db.Uuid
  coverTypeId         String?  @map("cover_type_id") @db.Uuid
  /// Label pilihan form, misal "PAR + EQVET". Tidak semua label punya padanan di cover_types.
  typeOfCover         String?  @map("type_of_cover")
  insuredName         String   @map("insured_name")
  riskLocation        String?  @map("risk_location")
  inceptionDate       DateTime @map("inception_date") @db.Date
  expiryDate          DateTime @map("expiry_date") @db.Date
  currencyCode        String   @map("currency_code")
  sumInsured          Decimal  @default(0) @map("sum_insured") @db.Decimal(18, 2)
  /// Negatif untuk pengembalian premi pada pembatalan.
  premium             Decimal  @default(0) @db.Decimal(18, 2)
  brokeragePct        Decimal  @default(0) @map("brokerage_pct") @db.Decimal(12, 6)
  /// Brokerage sudah termasuk PPN 2,2%, mengikuti Include VAT di slip.
  includeVat          Boolean  @default(false) @map("include_vat")
  /// Nominal fee di luar brokerage, dalam mata uang polis: premi × fee (%) per
  /// asuransi (`policy_insurers.additional_fee_pct`), dihitung server. Negatif
  /// pada pembatalan atau pengurangan premi.
  additionalFee       Decimal  @default(0) @map("additional_fee") @db.Decimal(18, 2)
  /// Additional fee sudah termasuk PPN 2,2%, mengikuti slip.
  additionalFeeIncludeVat Boolean @default(false) @map("additional_fee_include_vat")
  /// Rate (%) endorsement: premi = sum insured × rate × hari prorata / 365,
  /// hari prorata dari tanggal efektif s/d tanggal berakhir (Harry, 11 November
  /// 2026). Kosong berarti premi diisi manual.
  rate                Decimal? @db.Decimal(12, 6)
  /// Sum insured dasar premi prorata. Kosong berarti memakai sum insured
  /// endorsement (tambahan UP); diisi UP penuh kalau rate atau jaminan berubah
  /// tanpa mengubah UP, seperti rumus prorata Harry.
  premiumBasis        Decimal? @map("premium_basis") @db.Decimal(18, 2)
  /// Biaya administrasi dan bea meterai endorsement; total premi = premi +
  /// keduanya. Premi produksi tetap kolom premium.
  adminCost           Decimal  @default(0) @map("admin_cost") @db.Decimal(18, 2)
  stampDuty           Decimal  @default(0) @map("stamp_duty") @db.Decimal(18, 2)
  /// Tanggal premi dibayar; kosong berarti belum dibayar. Diisi manual di
  /// Policy Database dan tampil saat klaim dicatat (meeting LCH, 10 November
  /// 2026). Bagian B bisa mengisinya dari pencatatan pembayaran premi.
  premiumPaidDate     DateTime? @map("premium_paid_date") @db.Date
  /// Uraian perubahan endorsement atau alasan pembatalan, teks bebas (meeting
  /// LCH, 10 November 2026). Hanya untuk tipe Endorsement dan Cancellation.
  remarks             String?
  /// lookup policy_type: Baru, Renewal, Endorsement, Cancellation.
  policyTypeId        String   @map("policy_type_id") @db.Uuid
  /// Polis induk untuk renewal, endorsement, dan pembatalan.
  parentPolicyId      String?  @map("parent_policy_id") @db.Uuid
  /// No. polis sebelumnya untuk renewal yang polis lamanya belum ada di sistem,
  /// karena sistem baru dipakai sejak 2026 (Agus, 9 November 2026). Kosong bila
  /// polis sebelumnya dipilih lewat parent_policy_id.
  previousPolicyNo    String?  @map("previous_policy_no")
  /// Nomor urut endorsement pada polis induk, diisi server saat polis endorsement disimpan.
  endorsementSeq      Int?     @map("endorsement_seq")
  cobOjkClassId       String?  @map("cob_ojk_class_id") @db.Uuid
  /// lookup placement_location: Dalam Negeri, Luar Negeri.
  placementLocationId String?  @map("placement_location_id") @db.Uuid
  /// Pengelompokan klien untuk laporan produksi.
  groupingInsured     String?  @map("grouping_insured")
  /// Limit manfaat PA, disalin dari slip saat polis dibuat.
  paBenefitLimits     Json?    @map("pa_benefit_limits") @db.JsonB

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  cobOjkClass       CobOjkClass?    @relation(fields: [cobOjkClassId], references: [id])
  placementLocation LookupValue?    @relation("placement_location", fields: [placementLocationId], references: [id])
  placingSlip       PlacingSlip?    @relation(fields: [placingSlipId], references: [id])
  client            Client?         @relation(fields: [clientId], references: [id])
  cob               ClassOfBusiness @relation(fields: [cobId], references: [id])
  coverType         CoverType?      @relation(fields: [coverTypeId], references: [id])
  currency          Currency        @relation(fields: [currencyCode], references: [code])
  policyType        LookupValue     @relation("policy_type", fields: [policyTypeId], references: [id])
  parentPolicy      Policy?         @relation("policyParent", fields: [parentPolicyId], references: [id])

  childPolicies Policy[]        @relation("policyParent")
  /// Endorsement dan cancellation slip di Placement untuk polis ini.
  endorsementSlips PlacingSlip[] @relation("slipParentPolicy")
  insurers      PolicyInsurer[]
  files         PolicyFile[]
  claims        Claim[]
  debitNotes    DebitNote[]
  /// Daftar peserta PA grup milik polis ini (polis Baru atau Renewal).
  participants        PolicyParticipant[] @relation("policyParticipants")
  /// Peserta yang ditambah atau dikurangi oleh polis endorsement ini.
  participantsAdded   PolicyParticipant[] @relation("participantsAdded")
  participantsRemoved PolicyParticipant[] @relation("participantsRemoved")

  @@unique([parentPolicyId, endorsementSeq])
  @@index([clientId])
  @@index([expiryDate])
  @@map("policies")
}

/// Peserta PA grup per polis (jawaban Harry, 6 November 2026): disalin dari
/// slip saat polis dibuat, lalu bertambah atau berkurang lewat endorsement.
/// Klaim PA nantinya menunjuk peserta ini.
model PolicyParticipant {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Polis pemilik daftar: polis Baru atau Renewal, bukan endorsement.
  policyId          String    @map("policy_id") @db.Uuid
  name              String
  /// NIK atau nomor paspor.
  idNumber          String?   @map("id_number")
  birthDate         DateTime? @map("birth_date") @db.Date
  gender            String?
  position          String?
  level             String?
  workLocation      String?   @map("work_location")
  sumInsured        Decimal   @default(0) @map("sum_insured") @db.Decimal(18, 2)
  beneficiary       String?
  sortOrder         Int       @default(0) @map("sort_order")
  /// Mulai dijamin: tanggal mulai polis, atau tanggal endorsement penambahan.
  startDate         DateTime  @map("start_date") @db.Date
  /// Berhenti dijamin karena endorsement pengurangan. Kosong berarti aktif.
  endDate           DateTime? @map("end_date") @db.Date
  /// Endorsement yang menambah peserta ini; kosong untuk peserta awal.
  addedByPolicyId   String?   @map("added_by_policy_id") @db.Uuid
  /// Endorsement yang mengurangi peserta ini.
  removedByPolicyId String?   @map("removed_by_policy_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  policy    Policy  @relation("policyParticipants", fields: [policyId], references: [id], onDelete: Cascade)
  addedBy   Policy? @relation("participantsAdded", fields: [addedByPolicyId], references: [id], onDelete: Cascade)
  removedBy Policy? @relation("participantsRemoved", fields: [removedByPolicyId], references: [id], onDelete: SetNull)
  claims    Claim[]

  @@index([policyId, sortOrder])
  @@index([addedByPolicyId])
  @@index([removedByPolicyId])
  @@map("policy_participants")
}

/// Lampiran placing slip, misalnya vessel schedule, daftar unit, atau klausul
/// hasil scan (analisa contoh slip LCH, Tahap 3 nomor 19). Isinya di
/// stored_files dengan purpose slip_attachment.
model SlipFile {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slipId      String   @map("slip_id") @db.Uuid
  /// Keterangan yang dicetak, misalnya "Vessel Schedule". Kosong memakai nama file.
  description String?
  fileName    String   @map("file_name")
  filePath    String   @map("file_path")
  sizeBytes   Int      @default(0) @map("size_bytes")
  sortOrder   Int      @default(0) @map("sort_order")
  /// Isi lampiran ikut tercetak di halaman akhir dokumen slip: gambar per
  /// halaman, Excel sebagai tabel, PDF per halaman (jawaban Harry, 9 November
  /// 2026). Mati berarti hanya namanya yang tercetak di daftar ATTACHMENTS.
  printContent Boolean @default(true) @map("print_content")
  uploadedBy  String   @map("uploaded_by") @db.Uuid
  uploadedAt  DateTime @default(now()) @map("uploaded_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  slip     PlacingSlip @relation(fields: [slipId], references: [id], onDelete: Cascade)
  uploader User        @relation(fields: [uploadedBy], references: [id])

  @@index([slipId, sortOrder])
  @@map("slip_files")
}

/// Disalin dari slip_security_panel saat polis dibuat dari slip. Jadi dasar
/// pembagian Credit Note co-insurance.
model PolicyInsurer {
  id         String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  policyId   String  @map("policy_id") @db.Uuid
  insurerId  String  @map("insurer_id") @db.Uuid
  sharePct   Decimal @map("share_pct") @db.Decimal(12, 6)
  /// lookup security_role
  positionId String  @map("position_id") @db.Uuid
  /// Additional fee (%) dari premi bagian asuransi ini, dari panel slip.
  additionalFeePct Decimal @default(0) @map("additional_fee_pct") @db.Decimal(12, 6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  policy   Policy      @relation(fields: [policyId], references: [id], onDelete: Cascade)
  insurer  Insurer     @relation(fields: [insurerId], references: [id])
  position LookupValue @relation("security_role_policy", fields: [positionId], references: [id])

  @@unique([policyId, insurerId])
  @@map("policy_insurers")
}

/// Jenis berkas polis (Agus, 9 November 2026): softcopy polis, Premium Note,
/// dan Commission Note dari asuransi.
enum PolicyFileKind {
  Policy
  PremiumNote
  CommissionNote
  /// Dokumen slip untuk polis yang slipnya dibuat di luar sistem LCH
  /// (meeting LCH, 10 November 2026).
  Slip
}

/// Berkas polis. Version naik setiap upload per jenis, file lama tetap tersimpan.
model PolicyFile {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  policyId   String   @map("policy_id") @db.Uuid
  kind       PolicyFileKind @default(Policy)
  version    Int      @default(1)
  fileName   String   @map("file_name")
  filePath   String   @map("file_path")
  uploadedBy String   @map("uploaded_by") @db.Uuid
  uploadedAt DateTime @default(now()) @map("uploaded_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  policy   Policy @relation(fields: [policyId], references: [id], onDelete: Cascade)
  uploader User   @relation(fields: [uploadedBy], references: [id])

  @@unique([policyId, kind, version])
  @@map("policy_files")
}

/// Potongan berkas yang sedang diunggah. Vercel menolak body request di atas
/// 4,5 MB, jadi berkas besar dikirim per potongan lalu digabung di server
/// menjadi stored_files. Baris dihapus setelah digabung; sisa unggahan yang
/// tidak selesai dibersihkan setelah sehari.
model UploadPart {
  uploadId   String   @map("upload_id") @db.Uuid
  partNo     Int      @map("part_no")
  data       Bytes
  uploadedBy String   @map("uploaded_by") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  uploader User @relation(fields: [uploadedBy], references: [id], onDelete: Cascade)

  @@id([uploadId, partNo])
  @@index([createdAt])
  @@map("upload_parts")
}

/// Asuransi dan COB klaim diambil dari polis, tidak dipilih ulang di form.
/// paid_amount adalah nilai penyelesaian yang dicatat tim Klaim. Uang klaim
/// yang lewat rekening LCH dicatat Finance di payments.
model Claim {
  id                   String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  claimNo              String    @unique @map("claim_no")
  policyId             String    @map("policy_id") @db.Uuid
  adjusterId           String?   @map("adjuster_id") @db.Uuid
  lossDate             DateTime  @map("loss_date") @db.Date
  reportedDate         DateTime? @map("reported_date") @db.Date
  documentCompleteDate DateTime? @map("document_complete_date") @db.Date
  spkDate              DateTime? @map("spk_date") @db.Date
  location             String?
  lossDescription      String?   @map("loss_description")
  assetDescription     String?   @map("asset_description")
  currencyCode         String    @map("currency_code")
  estimatedLoss        Decimal   @default(0) @map("estimated_loss") @db.Decimal(18, 2)
  claimedAmount        Decimal   @default(0) @map("claimed_amount") @db.Decimal(18, 2)
  paidAmount           Decimal   @default(0) @map("paid_amount") @db.Decimal(18, 2)
  /// lookup claim_status: Outstanding, Settled, Closed, Rejected
  statusId             String    @map("status_id") @db.Uuid
  /// lookup claim_stage: tahapan dokumen, berjalan sendiri di samping status
  stageId              String?   @map("stage_id") @db.Uuid
  notes                String?
  /// Peserta PA grup yang mengalami kejadian (jawaban Harry, 6 November 2026).
  participantId        String?   @map("participant_id") @db.Uuid
  /// lookup pa_benefit: jenis manfaat klaim PA (meninggal, cacat, biaya medis).
  paBenefitId          String?   @map("pa_benefit_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  policy   Policy       @relation(fields: [policyId], references: [id])
  adjuster Adjuster?    @relation(fields: [adjusterId], references: [id])
  currency Currency     @relation(fields: [currencyCode], references: [code])
  status   LookupValue  @relation("claim_status", fields: [statusId], references: [id])
  stage    LookupValue? @relation("claim_stage", fields: [stageId], references: [id])

  participant PolicyParticipant? @relation(fields: [participantId], references: [id], onDelete: Restrict)
  paBenefit   LookupValue?       @relation("claim_pa_benefit", fields: [paBenefitId], references: [id], onDelete: Restrict)

  payments  Payment[]
  documents ClaimDocument[]
  followups ClaimFollowup[]

  @@index([policyId])
  @@index([statusId])
  @@index([participantId])
  @@index([paBenefitId])
  @@map("claims")
}

/// Berkas dan dokumen kelengkapan klaim (PRD A-18, ERD claim_documents).
model ClaimDocument {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  claimId        String    @map("claim_id") @db.Uuid
  documentTypeId String?   @map("document_type_id") @db.Uuid
  isReceived     Boolean   @default(false) @map("is_received")
  receivedDate   DateTime? @map("received_date") @db.Date
  filePath       String?   @map("file_path")
  notes          String?

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  claim        Claim              @relation(fields: [claimId], references: [id], onDelete: Cascade)
  documentType ClaimDocumentType? @relation(fields: [documentTypeId], references: [id])

  @@index([claimId])
  @@index([documentTypeId])
  @@map("claim_documents")
}

/// Riwayat tindak lanjut penanganan klaim bertanggal (PRD A-18, ERD claim_followups).
/// Contoh: "Menunggu invoice penjualan, reminder ketiga".
model ClaimFollowup {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  claimId      String   @map("claim_id") @db.Uuid
  followupDate DateTime @map("followup_date") @db.Date
  note         String
  createdById  String?  @map("created_by") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  claim     Claim @relation(fields: [claimId], references: [id], onDelete: Cascade)
  createdBy User? @relation(fields: [createdById], references: [id])

  @@index([claimId])
  @@map("claim_followups")
}

// ---------------------------------------------------------------------------
// 5. Finance
// ---------------------------------------------------------------------------

model BankAccount {
  id             String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// lookup bank
  bankId         String  @map("bank_id") @db.Uuid
  accountNo      String  @map("account_no")
  accountName    String  @map("account_name")
  currencyCode   String  @map("currency_code")
  /// Rekening dana premi titipan, dipisah dari rekening operasional di
  /// pembukuan.
  isPremiumTrust Boolean @default(false) @map("is_premium_trust")
  coaAccountId   String? @map("coa_account_id") @db.Uuid
  isActive       Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  bank       LookupValue @relation("bank", fields: [bankId], references: [id])
  currency   Currency    @relation(fields: [currencyCode], references: [code])
  coaAccount CoaAccount? @relation(fields: [coaAccountId], references: [id])

  payments Payment[]

  @@map("bank_accounts")
}

/// Debit Note atau Premium Note, tagihan premi ke tertanggung.
/// Status lunas dan sisa tagihan dihitung dari payments, tidak disimpan.
model DebitNote {
  id             String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  dnNo           String  @unique @map("dn_no")
  policyId       String  @map("policy_id") @db.Uuid
  clientId       String  @map("client_id") @db.Uuid
  /// Salinan saat dokumen dibuat, jadi perubahan data klien tidak mengubah
  /// dokumen yang sudah terbit.
  insuredName    String  @map("insured_name")
  billingAddress String? @map("billing_address")
  /// lookup payment_model: via rekening LCH atau langsung ke asuransi.
  paymentModelId String  @map("payment_model_id") @db.Uuid

  issueDate    DateTime @map("issue_date") @db.Date
  dueDate      DateTime @map("due_date") @db.Date
  currencyCode String   @map("currency_code")
  /// Kurs ke IDR saat dokumen terbit.
  exchangeRate Decimal  @default(1) @map("exchange_rate") @db.Decimal(12, 6)

  premium    Decimal @default(0) @db.Decimal(18, 2)
  discount   Decimal @default(0) @db.Decimal(18, 2)
  policyCost Decimal @default(0) @map("policy_cost") @db.Decimal(18, 2)
  stampDuty  Decimal @default(0) @map("stamp_duty") @db.Decimal(18, 2)
  /// Sudah termasuk baris penyesuaian di debit_note_lines.
  total      Decimal @default(0) @db.Decimal(18, 2)

  referenceNo String?   @map("reference_no")
  lcNo        String?   @map("lc_no")
  /// Khusus marine.
  etd         DateTime? @db.Date

  status   NoteStatus @default(Draft)
  issuedBy String?    @map("issued_by") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  policy       Policy      @relation(fields: [policyId], references: [id])
  client       Client      @relation(fields: [clientId], references: [id])
  paymentModel LookupValue @relation("payment_model", fields: [paymentModelId], references: [id])
  currency     Currency    @relation(fields: [currencyCode], references: [code])
  issuer       User?       @relation(fields: [issuedBy], references: [id])

  lines       DebitNoteLine[]
  creditNotes CreditNote[]
  payments    Payment[]

  @@index([clientId])
  @@index([dueDate])
  @@map("debit_notes")
}

/// Baris penyesuaian pada Debit Note, boleh positif maupun negatif.
model DebitNoteLine {
  id          String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  debitNoteId String  @map("debit_note_id") @db.Uuid
  description String
  amount      Decimal @db.Decimal(18, 2)
  sortOrder   Int     @default(0) @map("sort_order")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  debitNote DebitNote @relation(fields: [debitNoteId], references: [id], onDelete: Cascade)

  @@index([debitNoteId, sortOrder])
  @@map("debit_note_lines")
}

/// Satu Debit Note dipecah jadi Credit Note per asuransi sesuai share, lalu
/// per cicilan. Contoh nomor 0581/CNLCH/08/2026-1.
///
/// Pembagian share dan cicilan dibulatkan ke sen, selisihnya masuk ke baris
/// terakhir.
model CreditNote {
  id              String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  cnNo            String  @unique @map("cn_no")
  debitNoteId     String  @map("debit_note_id") @db.Uuid
  insurerId       String  @map("insurer_id") @db.Uuid
  sharePct        Decimal @map("share_pct") @db.Decimal(12, 6)
  instalmentNo    Int     @default(1) @map("instalment_no")
  instalmentCount Int     @default(1) @map("instalment_count")

  dueDate      DateTime @map("due_date") @db.Date
  currencyCode String   @map("currency_code")
  exchangeRate Decimal  @default(1) @map("exchange_rate") @db.Decimal(12, 6)

  grossPremium    Decimal @default(0) @map("gross_premium") @db.Decimal(18, 2)
  brokerageAmount Decimal @default(0) @map("brokerage_amount") @db.Decimal(18, 2)
  /// PPN 11% atas brokerage.
  ppnAmount       Decimal @default(0) @map("ppn_amount") @db.Decimal(18, 2)
  pph23Amount     Decimal @default(0) @map("pph23_amount") @db.Decimal(18, 2)
  /// Yang disetor ke asuransi.
  netAmount       Decimal @default(0) @map("net_amount") @db.Decimal(18, 2)

  status   NoteStatus @default(Draft)
  issuedBy String?    @map("issued_by") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  debitNote DebitNote @relation(fields: [debitNoteId], references: [id])
  insurer   Insurer   @relation(fields: [insurerId], references: [id])
  currency  Currency  @relation(fields: [currencyCode], references: [code])
  issuer    User?     @relation(fields: [issuedBy], references: [id])

  payments Payment[]

  @@unique([debitNoteId, insurerId, instalmentNo])
  @@index([dueDate])
  @@map("credit_notes")
}

/// Penerimaan dan pengeluaran uang.
///
/// Jenis pembayaran menentukan dokumen yang wajib diisi: terima premi ke Debit
/// Note, setor premi dan terima brokerage ke Credit Note, terima dan bayar
/// klaim ke klaim. Divalidasi di server, bukan di database.
///
/// Satu transfer yang membayar beberapa dokumen dicatat sebagai beberapa baris
/// dengan bank_reference yang sama.
model Payment {
  id            String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// lookup payment_type
  paymentTypeId String  @map("payment_type_id") @db.Uuid
  debitNoteId   String? @map("debit_note_id") @db.Uuid
  creditNoteId  String? @map("credit_note_id") @db.Uuid
  claimId       String? @map("claim_id") @db.Uuid
  bankAccountId String  @map("bank_account_id") @db.Uuid

  paymentDate   DateTime @map("payment_date") @db.Date
  currencyCode  String   @map("currency_code")
  exchangeRate  Decimal  @default(1) @map("exchange_rate") @db.Decimal(12, 6)
  amount        Decimal  @db.Decimal(18, 2)
  bankReference String?  @map("bank_reference")
  notes         String?
  createdBy     String   @map("created_by") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  paymentType LookupValue @relation("payment_type", fields: [paymentTypeId], references: [id])
  debitNote   DebitNote?  @relation(fields: [debitNoteId], references: [id])
  creditNote  CreditNote? @relation(fields: [creditNoteId], references: [id])
  claim       Claim?      @relation(fields: [claimId], references: [id])
  bankAccount BankAccount @relation(fields: [bankAccountId], references: [id])
  currency    Currency    @relation(fields: [currencyCode], references: [code])
  creator     User        @relation(fields: [createdBy], references: [id])

  @@index([paymentDate])
  @@index([bankReference])
  @@map("payments")
}

// ---------------------------------------------------------------------------
// 6. Akuntansi
// ---------------------------------------------------------------------------

model CoaAccount {
  id              String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code            String  @unique
  name            String
  /// lookup account_type: Asset, Liability, Equity, Revenue, Expense.
  accountTypeId   String  @map("account_type_id") @db.Uuid
  parentId        String? @map("parent_id") @db.Uuid
  /// Akun kontrol sub ledger piutang klien dan hutang asuransi.
  isControl       Boolean @default(false) @map("is_control")
  /// lookup ojk_report_line. Menentukan baris laporan OJK.
  ojkReportLineId String? @map("ojk_report_line_id") @db.Uuid
  isActive        Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  accountType   LookupValue  @relation("account_type", fields: [accountTypeId], references: [id])
  ojkReportLine LookupValue? @relation("ojk_report_line", fields: [ojkReportLineId], references: [id])
  parent        CoaAccount?  @relation("coaParent", fields: [parentId], references: [id])

  children     CoaAccount[]  @relation("coaParent")
  bankAccounts BankAccount[]
  journalLines JournalLine[]

  @@map("coa_accounts")
}

/// Jurnal otomatis dibuat saat Debit Note atau Credit Note terbit dan saat
/// pembayaran dicatat. source_type dan source_id menunjuk transaksi asalnya.
/// Jurnal yang sudah Posted tidak diedit, koreksinya lewat jurnal manual.
model JournalEntry {
  id          String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  journalNo   String        @unique @map("journal_no")
  journalDate DateTime      @map("journal_date") @db.Date
  description String?
  sourceType  JournalSource @default(Manual) @map("source_type")
  sourceId    String?       @map("source_id") @db.Uuid
  status      JournalStatus @default(Draft)
  createdBy   String        @map("created_by") @db.Uuid
  postedAt    DateTime?     @map("posted_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  creator User @relation(fields: [createdBy], references: [id])

  lines JournalLine[]

  @@index([journalDate])
  @@index([sourceType, sourceId])
  @@map("journal_entries")
}

/// Total debit wajib sama dengan total kredit, divalidasi di server.
/// client_id dan insurer_id membentuk sub ledger piutang dan hutang pada akun
/// kontrol.
model JournalLine {
  id             String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  journalEntryId String  @map("journal_entry_id") @db.Uuid
  accountId      String  @map("account_id") @db.Uuid
  clientId       String? @map("client_id") @db.Uuid
  insurerId      String? @map("insurer_id") @db.Uuid
  /// Dalam IDR.
  debit          Decimal @default(0) @db.Decimal(18, 2)
  credit         Decimal @default(0) @db.Decimal(18, 2)
  memo           String?

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  journalEntry JournalEntry @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)
  account      CoaAccount   @relation(fields: [accountId], references: [id])
  client       Client?      @relation(fields: [clientId], references: [id])
  insurer      Insurer?     @relation(fields: [insurerId], references: [id])

  @@index([journalEntryId])
  @@index([accountId])
  @@map("journal_lines")
}
