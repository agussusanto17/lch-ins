// Schema Sistem Back Office PT. LCH Insurance Brokers.
//
// Diturunkan dari ERD di Notion:
// https://app.notion.com/p/3d84848a839381bbbf0deaab63eed08a
//
// Konvensi (lihat bagian Konvensi di ERD):
// - Nama model PascalCase, nama tabel dan kolom tetap snake_case lewat @@map/@map.
// - Primary key `uuid` di semua tabel, kecuali tabel referensi berkode
//   (currencies, document_types, bi_scales) yang memakai kodenya sendiri.
// - `money`  -> Decimal(18,2), dibaca sebagai Decimal.js. Jangan pernah diubah
//   ke Number, karena nominal harus presisi sampai sen.
// - `rate`   -> Decimal(12,6). Satuan per mil atau persen mengikuti COB.
// - Kolom `*_id` yang menunjuk LookupValue adalah daftar pilihan pendek yang
//   dikelola Admin di master data. Nama relasinya dipakai sebagai lookup_type.
// - Status yang berubah lewat tombol aksi dikunci di kode, jadi ditulis sebagai
//   enum, bukan teks bebas.
// - Master data yang sudah dipakai cukup is_active = false. Dokumen bernomor
//   tidak dihapus, statusnya Cancelled.

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

// Mulai Prisma 7, connection string tidak lagi ditulis di sini.
// URL-nya ada di prisma.config.ts di root project.
datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enum
// ---------------------------------------------------------------------------

/// Status placing slip. Berubah lewat tombol aksi, bukan dropdown.
enum SlipStatus {
  Draft
  Released
  Quoted
  Closed
  Cancelled
}

/// Jenis slip di menu Placement (Harry, 11 November 2026).
enum SlipKind {
  Placing
  Endorsement
  Cancellation
}

/// Status SPPA.
enum SppaStatus {
  Draft
  Submitted
}

/// Status dokumen finance: Debit Note dan Credit Note.
enum NoteStatus {
  Draft
  Issued
  Cancelled
}

/// Status jurnal.
enum JournalStatus {
  Draft
  Posted
  Void
}

/// Asal jurnal. Manual diisi Finance, sisanya dibuat sistem.
enum JournalSource {
  Manual
  DebitNote
  CreditNote
  Payment
}

/// Jenis baris di slip_items, menentukan bagian mana yang diisi.
enum SlipItemKind {
  Interest
  SumInsuredSection1
  SumInsuredSection2
  /// Tidak dipakai lagi sejak deductible ditulis per cover (2 Nov 2026).
  DeductibleSection1
  DeductibleSection2
}

/// Aksi yang dicatat di audit trail.
enum AuditAction {
  Create
  Update
  Delete
  Release
  Cancel
}

/// Satuan tarif. Okupasi dan gempa properti per mil, banjir dan kendaraan
/// bermotor persen. Karena itu setiap tabel tarif menyimpan satuannya.
enum RateUnit {
  PerMil
  Percent
}

/// Jenis pertanggungan pada tarif kendaraan bermotor dan banjir.
enum CoverageType {
  Comprehensive
  TotalLossOnly
}

// ---------------------------------------------------------------------------
// 1. Sistem dan pengguna
// ---------------------------------------------------------------------------

model User {
  id                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name               String
  email              String   @unique
  /// Diisi Better Auth. LCH tidak memverifikasi email, jadi selalu true.
  emailVerified      Boolean  @default(true) @map("email_verified")
  /// Foto profil, dipakai Better Auth. Belum dipakai LCH.
  image              String?
  /// lookup role primer (opsional / warisan untuk backward compatibility)
  roleId             String?  @map("role_id") @db.Uuid
  /// Daftar role yang diberikan ke pengguna (multi-role)
  roles              String[] @default([]) @map("roles")
  /// Jabatan pengguna (opsional)
  jobTitle           String?  @map("job_title")
  /// Menandai apakah pengguna wajib mengganti password pada saat login pertama
  mustChangePassword Boolean  @default(false) @map("must_change_password")
  isActive           Boolean  @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  role LookupValue? @relation("role", fields: [roleId], references: [id])

  sessions          Session[]
  accounts          Account[]
  auditLogs         AuditLog[]
  clientDocuments   ClientDocument[]
  storedFiles       StoredFile[]
  sppa              Sppa[]
  slipsCreated      PlacingSlip[]    @relation("slipCreatedBy")
  slipsReleased     PlacingSlip[]    @relation("slipReleasedBy")
  policyFiles       PolicyFile[]
  uploadParts       UploadPart[]
  slipFiles         SlipFile[]
  debitNotesIssued  DebitNote[]
  creditNotesIssued CreditNote[]
  payments          Payment[]
  journalEntries    JournalEntry[]
  claimFollowups    ClaimFollowup[]

  @@index([roleId])
  @@map("users")
}

/// Sesi login aktif. Dikelola Better Auth; cookie hanya membawa `token`.
model Session {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  token     String   @unique
  userId    String   @map("user_id") @db.Uuid
  expiresAt DateTime @map("expires_at") @db.Timestamptz(6)
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

/// Kredensial pengguna. Untuk LCH hanya ada satu baris per pengguna dengan
/// provider "credential", dan `password` berisi hash-nya. Kolom token OAuth
/// dibiarkan kosong karena login eksternal tidak dipakai.
model Account {
  id                    String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  userId                String    @map("user_id") @db.Uuid
  password              String?
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at") @db.Timestamptz(6)
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at") @db.Timestamptz(6)
  scope                 String?

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("accounts")
}

/// Token sementara Better Auth, misalnya untuk reset kata sandi.
model Verification {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  identifier String
  value      String
  expiresAt  DateTime @map("expires_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([identifier])
  @@map("verifications")
}

/// Diisi di server setiap tambah, ubah, hapus, release, dan batal.
model AuditLog {
  id       String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId   String      @map("user_id") @db.Uuid
  /// Nama tabel yang diubah.
  entity   String
  entityId String      @map("entity_id") @db.Uuid
  action   AuditAction
  /// Nilai sebelum dan sesudah.
  changes  Json?       @db.JsonB

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id])

  @@index([entity, entityId])
  @@index([userId])
  @@index([createdAt])
  @@map("audit_logs")
}

/// Identitas LCH untuk kop surat dokumen cetak. Hanya berisi satu baris.
model CompanyProfile {
  id          String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String
  address     String
  phone       String?
  email       String?
  skojkNo     String? @map("skojk_no")
  apparindoNo String? @map("apparindo_no")
  logoPath    String? @map("logo_path")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("company_profile")
}

/// Jenis dokumen bernomor: PS, QS, CVN, CI, DN, CN, CLM, JV.
model DocumentType {
  code          String @id
  name          String
  /// Token: {seq:4}, {MM}, {MMROMAN}, {YYYY}, {COVER}.
  /// Debit Note LCH: {seq:4}/DNLCH/{MM}/{YYYY}.
  numberPattern String @map("number_pattern")
  /// lookup reset_period. Menunggu jawaban LCH: bulanan, tahunan, atau berlanjut.
  resetPeriodId String @map("reset_period_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  resetPeriod LookupValue     @relation("reset_period", fields: [resetPeriodId], references: [id])
  counters    NumberCounter[]

  @@map("document_types")
}

/// Nomor urut terakhir per jenis dokumen per periode.
///
/// JANGAN menaikkan counter ini langsung. Pakai nextDocumentNumber() di
/// server/services/number-generator.ts, dan panggil di transaksi yang sama
/// dengan penyimpanan dokumen supaya nomor tidak bolong saat simpan gagal.
///
/// findUnique lalu update TIDAK aman, dua request bersamaan bisa dapat nomor
/// yang sama. Service itu memakai satu statement INSERT ... ON CONFLICT DO
/// UPDATE ... RETURNING, yang mengunci baris counter sampai transaksi selesai
/// seperti SELECT ... FOR UPDATE, sekaligus aman saat dua request membuat baris
/// periode baru bersamaan. SELECT FOR UPDATE tidak bisa mengunci baris yang
/// belum ada. Unique constraint di kolom nomor dokumen tetap jadi pengaman.
model NumberCounter {
  documentTypeCode String @map("document_type_code")
  /// Contoh 2026-08 untuk reset bulanan, 2026 untuk tahunan.
  period           String
  lastNumber       Int    @default(0) @map("last_number")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  documentType DocumentType @relation(fields: [documentTypeCode], references: [code])

  @@id([documentTypeCode, period])
  @@map("number_counters")
}

// ---------------------------------------------------------------------------
// 2. Master data
// ---------------------------------------------------------------------------

/// Semua daftar pilihan pendek. Admin mengelolanya dari satu halaman dengan
/// filter per lookup_type. Nilai yang dipakai logika sistem ditandai is_system:
/// labelnya boleh diubah, kodenya tidak, dan barisnya tidak bisa dihapus.
model LookupValue {
  id         String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Contoh: role, claim_status, payment_type.
  lookupType String  @map("lookup_type")
  /// Dipakai logika sistem.
  code       String
  /// Label yang tampil di dropdown.
  name       String
  sortOrder  Int     @default(0) @map("sort_order")
  isSystem   Boolean @default(false) @map("is_system")
  isActive   Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Relasi balik, satu per lookup_type. Sengaja tidak digambar di ERD supaya
  // diagramnya tetap terbaca.
  usersWithRole         User[]              @relation("role")
  documentTypes         DocumentType[]      @relation("reset_period")
  cobRateMode           ClassOfBusiness[]   @relation("rate_mode")
  cobFormVariant        ClassOfBusiness[]   @relation("form_variant")
  cobRateLineKinds      CobRateLine[]       @relation("rate_line_kind_default")
  slipRateLineKinds     SlipRateLine[]      @relation("rate_line_kind_slip")
  slipConstructionClass PlacingSlip[]       @relation("construction_class")
  locationConstructionClass SlipLocation[] @relation("location_construction_class")
  clientTypes           Client[]            @relation("client_type")
  clientIdTypes         Client[]            @relation("id_type")
  clientIncomeSources   Client[]            @relation("income_source")
  clientPurposes        Client[]            @relation("insurance_purpose")
  clientStatuses        Client[]            @relation("client_status")
  addressTypes          ClientAddress[]     @relation("address_type")
  clientDocumentTypes   ClientDocument[]    @relation("client_document_type")
  slipSecurityRoles     SlipSecurityPanel[] @relation("security_role_slip")
  policySecurityRoles   PolicyInsurer[]     @relation("security_role_policy")
  policyPlacements      Policy[]            @relation("placement_location")
  policyTypes           Policy[]            @relation("policy_type")
  claimStatuses         Claim[]             @relation("claim_status")
  claimStages           Claim[]             @relation("claim_stage")
  claimPaBenefits       Claim[]             @relation("claim_pa_benefit")
  paymentModels         DebitNote[]         @relation("payment_model")
  paymentTypes          Payment[]           @relation("payment_type")
  banks                 BankAccount[]       @relation("bank")
  accountTypes          CoaAccount[]        @relation("account_type")
  ojkReportLines        CoaAccount[]        @relation("ojk_report_line")

  @@unique([lookupType, code])
  @@index([lookupType, sortOrder])
  @@map("lookup_values")
}

model ClassOfBusiness {
  id            String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// 2 digit, contoh 03 untuk Marine Cargo.
  code          String  @unique
  name          String
  /// lookup rate_mode: per mil atau persen.
  rateModeId    String  @map("rate_mode_id") @db.Uuid
  /// lookup form_variant: property, motor, atau standard. Menentukan tampilan
  /// bagian Rate dan Premium di placing slip.
  formVariantId String  @map("form_variant_id") @db.Uuid
  isActive      Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  rateMode    LookupValue @relation("rate_mode", fields: [rateModeId], references: [id])
  formVariant LookupValue @relation("form_variant", fields: [formVariantId], references: [id])

  coverTypes         CoverType[]
  rateLines          CobRateLine[]
  clauses            Clause[]
  clients            Client[]
  sppa               Sppa[]
  placingSlips       PlacingSlip[]
  policies           Policy[]
  claimPics          InsurerClaimPic[]
  claimDocumentTypes ClaimDocumentType[]
  deductibleOptions  DeductibleOption[]

  @@map("classes_of_business")
}

model CoverType {
  id           String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  cobId        String  @map("cob_id") @db.Uuid
  /// 4 digit, contoh 0311 Marine Cargo Open Cover. Dua digit pertama adalah
  /// kode COB. Dipakai di nomor slip, jadi harus unik.
  code         String  @unique
  name         String
  /// Singkatan untuk token {COVER} di nomor dokumen, contoh PAR, IAR, MC.
  /// Kosong berarti segmen cover dilewati.
  abbreviation String?
  /// Urutan penggabungan singkatan bila slip mencakup lebih dari satu type of cover (A lebih dulu dari B).
  priority     String?
  /// Label bawaan Detail tambahan slip saat type of cover ini dipilih,
  /// misalnya Retroactive Date, Territorial Limit, Jurisdiction (Liability)
  /// atau Voyage, Conveyance (Marine Cargo). Diatur LCH di Master Data.
  detailLabels String[] @default([]) @map("detail_labels")
  /// Slip type of cover ini memakai Section 1 (Material Damage) dan Section 2
  /// (Third Party Liability), misalnya CAR dan EAR. Diatur LCH di Master Data.
  usesSections Boolean  @default(false) @map("uses_sections")
  /// Slip type of cover ini open cover: rate tanpa premi pasti, premi per
  /// deklarasi di polis, misalnya 0311 MOP. Diatur LCH di Master Data.
  openCover    Boolean  @default(false) @map("open_cover")
  /// Slip type of cover ini memakai tarif OJK: batas rate Property atau Motor
  /// Vehicle dan batas biaya akuisisi (brokerage). Mati untuk Heavy Equipment
  /// (Harry, 9 November 2026). Diatur LCH di Master Data.
  ojkTariff    Boolean  @default(true) @map("ojk_tariff")
  /// Label periode bawaan di dokumen slip, misalnya "Date of Tournament"
  /// (Hole in One). Kosong berarti "Period of Insurance".
  periodLabel  String?  @map("period_label")
  /// Lama periode bawaan dalam hari: tanggal akhir slip otomatis = tanggal
  /// mulai + sekian hari, misalnya 14 hari setelah ETD untuk single shipment
  /// atau 0 (hari yang sama) untuk Hole in One. Kosong berarti tidak otomatis.
  periodDays   Int?     @map("period_days")
  /// Teks pengganti tanggal akhir di dokumen slip, misalnya "until final
  /// destination" untuk single shipment.
  periodEndText String? @map("period_end_text")
  isActive     Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  cob ClassOfBusiness @relation(fields: [cobId], references: [id])

  clauses           Clause[]
  sppa              Sppa[]
  placingSlips      PlacingSlip[] @relation("SlipCoverType")
  placingSlips2     PlacingSlip[] @relation("SlipCoverType2")
  policies          Policy[]
  deductibleOptions DeductibleOption[]

  @@index([cobId])
  @@map("cover_types")
}

/// Merek kendaraan untuk SPPA dan slip Motor Vehicle.
model VehicleBrand {
  id        String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String  @unique
  sortOrder Int     @default(0) @map("sort_order")
  isActive  Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  types     VehicleType[]
  sppa      Sppa[]
  slipItems SlipItem[]

  @@map("vehicle_brands")
}

/// Tipe (model) kendaraan, selalu milik satu merek. Contoh: Toyota Innova Zenix.
model VehicleType {
  id       String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  brandId  String  @map("brand_id") @db.Uuid
  name     String
  isActive Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  brand     VehicleBrand @relation(fields: [brandId], references: [id], onDelete: Restrict)
  sppa      Sppa[]
  slipItems SlipItem[]

  @@unique([brandId, name])
  @@map("vehicle_types")
}

/// Baris rate bawaan per COB, contoh FLEXAS, FWTWD, dan RSMDCC untuk Property.
model CobRateLine {
  id        String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  cobId     String @map("cob_id") @db.Uuid
  /// lookup rate_line_kind: Rate, TPL, atau PA.
  kindId    String @map("kind_id") @db.Uuid
  label     String
  sortOrder Int    @default(0) @map("sort_order")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  cob  ClassOfBusiness @relation(fields: [cobId], references: [id])
  kind LookupValue     @relation("rate_line_kind_default", fields: [kindId], references: [id])

  @@index([cobId, sortOrder])
  @@map("cob_rate_lines")
}

/// Pilihan deductible di placing slip, per type of cover. Muncul sebagai
/// pilihan di isian deductible per cover; teksnya tetap bisa diubah di slip.
model DeductibleOption {
  id          String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  cobId       String  @map("cob_id") @db.Uuid
  /// Kosong berarti berlaku untuk semua type of cover dalam COB itu.
  coverTypeId String? @map("cover_type_id") @db.Uuid
  text        String
  isActive    Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  cob       ClassOfBusiness @relation(fields: [cobId], references: [id])
  coverType CoverType?      @relation(fields: [coverTypeId], references: [id], onDelete: Cascade)

  @@index([cobId, coverTypeId])
  @@map("deductible_options")
}

model Occupation {
  id       String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Kode okupasi SE OJK.
  code     String  @unique
  name     String
  isActive Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tariffs      TariffOccupation[]
  sppa         Sppa[]
  placingSlips PlacingSlip[]
  slipLocations SlipLocation[]

  @@map("occupations")
}

/// Tarif FLEXAS per okupasi dikali kelas konstruksi. Lampiran I SE OJK.
model TariffOccupation {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  occupationId      String   @map("occupation_id") @db.Uuid
  /// Kode kelas konstruksi: K1, K2, atau K3. Sama dengan code di
  /// lookup_values lookup_type construction_class.
  constructionClass String   @map("construction_class")
  rateMin           Decimal  @map("rate_min") @db.Decimal(12, 6)
  rateMax           Decimal  @map("rate_max") @db.Decimal(12, 6)
  rateUnit          RateUnit @default(PerMil) @map("rate_unit")
  isActive          Boolean  @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  occupation Occupation @relation(fields: [occupationId], references: [id])

  @@unique([occupationId, constructionClass])
  @@map("tariff_occupation")
}

/// Tarif gempa bumi harta benda: kategori konstruksi dikali zona.
/// Lampiran III SE OJK. Nilainya tunggal, bukan rentang.
model TariffEqProperty {
  id                   String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Contoh: Com: Steel, Wood, RC sampai 9 lantai.
  constructionCategory String   @map("construction_category")
  /// Zona 1 sampai Zona 5.
  zone                 String
  rate                 Decimal  @db.Decimal(12, 6)
  rateUnit             RateUnit @default(PerMil) @map("rate_unit")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([constructionCategory, zone])
  @@map("tariff_eq_property")
}

/// Tarif jaminan banjir: wilayah dikali zona. Satuannya persen.
/// Baris tanpa angka, misalnya "Tarif Zona 1 ditambah faktor loading",
/// mengisi note dan membiarkan rate_min serta rate_max kosong.
model TariffFlood {
  id           String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Harta benda atau kendaraan bermotor.
  line         String
  region       String
  /// Zona 1 sampai Zona 4.
  zone         String
  coverageType CoverageType? @map("coverage_type")
  rateMin      Decimal?      @map("rate_min") @db.Decimal(12, 6)
  rateMax      Decimal?      @map("rate_max") @db.Decimal(12, 6)
  note         String?
  rateUnit     RateUnit      @default(Percent) @map("rate_unit")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Tanpa unique constraint. Pembedanya berbeda antar lini: harta benda
  // memakai zona tanpa jenis pertanggungan, kendaraan bermotor sebaliknya.
  // Postgres menganggap NULL selalu berbeda, jadi constraint gabungan tidak
  // akan menjaga apa pun. Seed menulis ulang seluruh tabel ini.
  @@index([line, region])
  @@map("tariff_flood")
}

/// Tarif kendaraan bermotor: kategori dikali wilayah dikali jenis
