model Clause {
  id          String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title       String
  /// Kosong berarti berlaku untuk semua COB.
  cobId       String? @map("cob_id") @db.Uuid
  /// Kosong berarti berlaku untuk semua type of cover dalam COB itu.
  coverTypeId String? @map("cover_type_id") @db.Uuid
  /// HTML dari rich text editor, disanitasi sebelum disimpan.
  wordingHtml String  @map("wording_html")
  /// Kelompok produk asal klausul di pustaka wording LCH: PAR, EQVET, Cargo,
  /// CIS, CIT, MB, MV, PA, PL, Fidelity. Kosong berarti dibuat langsung di
  /// aplikasi. Dipakai membedakan 66 judul yang dipakai beberapa produk dengan
  /// wording berbeda, dan jadi dasar pemetaan ke COB (CLAUSE_GROUP_COB di seed).
  sourceGroup String  @default("") @map("source_group")
  /// Masuk paket klausul bawaan type of cover-nya, atau semua type of cover
  /// COB-nya bila type of cover kosong. Satu tombol di placing slip memasang
  /// semua klausul paket (analisa contoh slip LCH: 40 sampai 62 klausul).
  inPackage    Boolean @default(false) @map("in_package")
  /// Judul kelompok saat dipasang dari paket, misalnya "Extensions".
  packageGroup String? @map("package_group")
  /// Urutan di paket: kecil lebih dulu, lalu judul.
  packageOrder Int     @default(0) @map("package_order")
  isActive    Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  cob       ClassOfBusiness? @relation(fields: [cobId], references: [id])
  coverType CoverType?       @relation(fields: [coverTypeId], references: [id])

  slipClauses SlipClause[]

  @@unique([title, sourceGroup])
  @@index([cobId, coverTypeId])
